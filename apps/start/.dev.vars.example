# Cloudflare Workers, local dev only. Copy to .dev.vars before `yarn dev:cf` / `yarn build:cf`.
# In production, set these with `wrangler secret put <NAME>` instead.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CALENDSO_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
# Optional apps; see .env.example for what each needs and its redirect URI.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DAILY_API_KEY=
JITSI_HOST=
STRIPE_PRIVATE_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
