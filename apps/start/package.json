{
  "name": "@calcom/start",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:cf": "DEPLOY_TARGET=cloudflare vite dev --port 3000",
    "build": "vite build",
    "build:cf": "DEPLOY_TARGET=cloudflare vite build",
    "start": "node ./server.node.mjs",
    "deploy:cf": "yarn build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@calcom/db": "workspace:*",
    "@calcom/i18n": "workspace:*",
    "@calcom/lib": "workspace:*",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "srvx": "1.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "20.17.23",
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.9",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.8",
    "wrangler": "4.149.0"
  }
}
