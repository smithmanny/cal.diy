{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "paths": {
      "#db-driver": ["./src/server/db/node.ts"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
