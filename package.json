{
  "name": "cal-diy",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/embeds/*"
  ],
  "scripts": {
    "dev": "yarn workspace @calcom/web dev",
    "dev:cf": "yarn workspace @calcom/web dev:cf",
    "build": "yarn workspace @calcom/web build",
    "build:cf": "yarn workspace @calcom/web build:cf",
    "start": "yarn workspace @calcom/web start",
    "deploy:cf": "yarn workspace @calcom/web deploy:cf",
    "db:generate": "yarn workspace @calcom/db db:generate",
    "db:migrate:d1:local": "yarn workspace @calcom/db db:migrate:d1:local",
    "db:migrate:d1:remote": "yarn workspace @calcom/db db:migrate:d1:remote",
    "import:postgres": "yarn workspace @calcom/web import:postgres",
    "type-check": "yarn workspaces foreach -A --include '@calcom/{web,db,scheduling}' run type-check",
    "test": "TZ=UTC yarn workspaces foreach -A --include '@calcom/{web,db,scheduling}' run test",
    "e2e": "yarn workspace @calcom/web test:e2e",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "postinstall": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
